{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "allowUnusedLabels": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/app/(protected)/ai/components/Avatar.jsx",
    "src/app/(protected)/ai/components/Environement.jsx",
    "src/app/(protected)/ai/components/Experience.jsx",
    "src/app/(protected)/ai/components/UI.jsx",
    "src/app/[locale]/(landing)/changelog/tsx.mdx",
    "src/app/[locale]/(landing)/changelog/page.tsx"
, "src/app/[locale]/(protected)/appointment/flow-edit"  ],
  "exclude": ["node_modules"]
}
